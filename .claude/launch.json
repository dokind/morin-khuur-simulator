{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "renderer-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:web"
      ],
      "port": 5173
    },
    {
      "name": "renderer-measure",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--config",
        ".claude/vite.measure.config.ts"
      ],
      "port": 5174
    },
    {
      "name": "site",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "http-server",
        "site",
        "-p",
        "5181",
        "-s",
        "-c-1"
      ],
      "port": 5181
    }
  ]
}